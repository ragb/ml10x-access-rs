    "ControllerYaml": {
      "additionalProperties": false,
      "properties": {
        "connectors": {
          "allOf": [
            {
              "$ref": "#/$defs/ConnectorsYaml"
            }
          ],
          "default": {
            "a_ring": {
              "input_name": "",
              "name": "",
              "output_name": "",
              "short_name": ""
            },
            "a_tip": {
              "input_name": "",
